POSTGRES_DB=seguimiento_demo
POSTGRES_USER=seguimiento
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://seguimiento:change-this-local-password@db:5432/seguimiento_demo
APP_ENV=demo
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_PATH=/data/images
RETENTION_DAYS=30
SESSION_MINUTES=60
# Profesional existente para asignar nuevas cuentas; vacío requiere asignación manual.
REGISTRATION_CLINICIAN_EMAIL=
INFERENCE_MODE=demo
SEGMENTATION_ENABLED=false
SEGMENTATION_MODEL_PATH=model_artifacts/best.pt
SEGMENTATION_THREADS=2
DEMO_PASSWORD=replace-with-a-demo-password
PRIVACY_CONTROLLER=Pendiente de configuración y revisión
PRIVACY_ADDRESS=Pendiente de configuración y revisión
PRIVACY_CONTACT=Pendiente de configuración y revisión
